datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-3.0.x"]
}

enum Role {
  OWNER
  ACCOUNTANT
  SUPERVISOR
}

enum SiteStatus {
  ACTIVE
  ARCHIVED
}

enum WorkerStatus {
  ACTIVE
  INACTIVE
  ARCHIVED
}

enum VerificationStatus {
  UNVERIFIED
  AADHAAR_SUBMITTED
  VERIFIED
}

enum WageType {
  DAILY
  HOURLY
}

enum AssignmentStatus {
  ACTIVE
  COMPLETED
}

enum AttendanceStatus {
  PRESENT
  HALF_DAY
  ABSENT
}

enum SubmissionStatus {
  DRAFT
  SUBMITTED
  APPROVED
  REJECTED
}

enum CorrectionStatus {
  PENDING
  APPROVED
  REJECTED
}

enum WageEntryStatus {
  ACTIVE
  SUPERSEDED
  REVERSED
}

enum EmailJobStatus {
  PENDING
  PROCESSING
  SENT
  FAILED
}

model Organization {
  id        String   @id @default(uuid()) @map("_id")
  name      String
  slug      String   @unique
  code      String   @unique
  phone     String?
  address   String?
  gstin     String?
  currency  String   @default("INR")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users                 User[]
  sessions              Session[]
  sites                 Site[]
  workers               Worker[]
  auditLogs             AuditLog[]
  attendanceSubmissions AttendanceSubmission[]
  attendances           Attendance[]
  wageEntries           WageEntry[]
  attendanceCorrections AttendanceCorrection[]

  @@map("organizations")
}

model User {
  id             String       @id @default(uuid()) @map("_id")
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  email          String       @unique
  phone          String?
  passwordHash   String
  name           String
  role           Role         @default(SUPERVISOR)
  isActive       Boolean      @default(true)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  sessions             Session[]
  passwordResetTokens  PasswordResetToken[]
  supervisorSites      SupervisorSite[]
  createdWageRates     WageRate[]
  auditLogs            AuditLog[]
  submittedSubmissions AttendanceSubmission[] @relation("SubmittedSubmissions")
  approvedSubmissions  AttendanceSubmission[] @relation("ApprovedSubmissions")
  rejectedSubmissions  AttendanceSubmission[] @relation("RejectedSubmissions")
  approvedWageEntries  WageEntry[]            @relation("ApprovedWageEntries")
  requestedCorrections AttendanceCorrection[] @relation("RequestedCorrections")
  reviewedCorrections  AttendanceCorrection[] @relation("ReviewedCorrections")

  @@index([organizationId, role])
  @@map("users")
}

model Session {
  id             String       @id @default(uuid()) @map("_id")
  token          String       @unique
  userId         String
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  ipAddress      String?
  userAgent      String?
  expiresAt      DateTime
  createdAt      DateTime     @default(now())

  @@index([userId])
  @@index([expiresAt])
  @@map("sessions")
}

model PasswordResetToken {
  id        String    @id @default(uuid()) @map("_id")
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@map("password_reset_tokens")
}

model Site {
  id             String       @id @default(uuid()) @map("_id")
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  code           String
  name           String
  location       String?
  clientName     String?
  status         SiteStatus   @default(ACTIVE)
  archivedAt     DateTime?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  supervisorSites       SupervisorSite[]
  workerAssignments     WorkerSiteAssignment[]
  attendanceSubmissions AttendanceSubmission[]
  attendances           Attendance[]
  wageEntries           WageEntry[]

  @@unique([organizationId, code])
  @@index([organizationId, status])
  @@map("sites")
}

model SupervisorSite {
  id         String   @id @default(uuid()) @map("_id")
  siteId     String
  site       Site     @relation(fields: [siteId], references: [id], onDelete: Cascade)
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  assignedAt DateTime @default(now())

  @@unique([siteId, userId])
  @@index([siteId])
  @@index([userId])
  @@map("supervisor_sites")
}

model Worker {
  id                 String             @id @default(uuid()) @map("_id")
  organizationId     String
  organization       Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  code               String
  name               String
  normalizedName     String
  mobileNumber       String?
  trade              String
  verificationStatus VerificationStatus @default(UNVERIFIED)
  aadhaarLastFour    String?
  status             WorkerStatus       @default(ACTIVE)
  archivedAt         DateTime?
  notes              String?
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt

  siteAssignments WorkerSiteAssignment[]
  wageRates       WageRate[]
  attendances     Attendance[]
  wageEntries     WageEntry[]

  @@unique([organizationId, code])
  @@index([organizationId, status])
  @@index([organizationId, normalizedName, mobileNumber])
  @@index([organizationId, mobileNumber])
  @@map("workers")
}

model WorkerSiteAssignment {
  id        String           @id @default(uuid()) @map("_id")
  workerId  String
  worker    Worker           @relation(fields: [workerId], references: [id], onDelete: Cascade)
  siteId    String
  site      Site             @relation(fields: [siteId], references: [id], onDelete: Cascade)
  startDate DateTime         @default(now())
  endDate   DateTime?
  status    AssignmentStatus @default(ACTIVE)
  notes     String?
  createdAt DateTime         @default(now())

  @@index([workerId, status])
  @@index([siteId, status])
  @@map("worker_site_assignments")
}

model WageRate {
  id              String      @id @default(uuid()) @map("_id")
  workerId        String
  worker          Worker      @relation(fields: [workerId], references: [id], onDelete: Cascade)
  wageType        WageType
  rate            Float
  effectiveFrom   DateTime
  effectiveTo     DateTime?
  notes           String?
  createdByUserId String?
  createdByUser   User?       @relation(fields: [createdByUserId], references: [id], onDelete: SetNull)
  createdAt       DateTime    @default(now())
  wageEntries     WageEntry[]

  @@index([workerId, effectiveFrom])
  @@map("wage_rates")
}

model AttendanceSubmission {
  id                String           @id @default(uuid()) @map("_id")
  organizationId    String
  organization      Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  siteId            String
  site              Site             @relation(fields: [siteId], references: [id], onDelete: Cascade)
  attendanceDate    DateTime
  status            SubmissionStatus @default(DRAFT)
  submittedByUserId String?
  submittedByUser   User?            @relation("SubmittedSubmissions", fields: [submittedByUserId], references: [id], onDelete: SetNull)
  submittedAt       DateTime?
  approvedByUserId  String?
  approvedByUser    User?            @relation("ApprovedSubmissions", fields: [approvedByUserId], references: [id], onDelete: SetNull)
  approvedAt        DateTime?
  rejectedByUserId  String?
  rejectedByUser    User?            @relation("RejectedSubmissions", fields: [rejectedByUserId], references: [id], onDelete: SetNull)
  rejectedAt        DateTime?
  rejectionReason   String?
  version           Int              @default(1)
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt

  attendances Attendance[]

  @@unique([organizationId, siteId, attendanceDate])
  @@index([organizationId, status])
  @@index([organizationId, attendanceDate])
  @@map("attendance_submissions")
}

model Attendance {
  id             String           @id @default(uuid()) @map("_id")
  organizationId String
  organization   Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  submissionId   String
  submission     AttendanceSubmission @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  workerId       String
  worker         Worker           @relation(fields: [workerId], references: [id], onDelete: Cascade)
  siteId         String
  site           Site             @relation(fields: [siteId], references: [id], onDelete: Cascade)
  attendanceDate DateTime
  status         AttendanceStatus
  hoursWorked    Float?
  payableUnits   Float
  notes          String?
  isCorrected    Boolean          @default(false)
  version        Int              @default(1)
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  wageEntries WageEntry[]
  corrections AttendanceCorrection[]

  @@unique([organizationId, workerId, attendanceDate])
  @@index([submissionId])
  @@index([organizationId, attendanceDate])
  @@index([siteId, attendanceDate])
  @@map("attendances")
}

model WageEntry {
  id               String          @id @default(uuid()) @map("_id")
  organizationId   String
  organization     Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  attendanceId     String
  attendance       Attendance      @relation(fields: [attendanceId], references: [id], onDelete: Cascade)
  workerId         String
  worker           Worker          @relation(fields: [workerId], references: [id], onDelete: Cascade)
  siteId           String
  site             Site            @relation(fields: [siteId], references: [id], onDelete: Cascade)
  attendanceDate   DateTime
  wageRateId       String
  wageRate         WageRate        @relation(fields: [wageRateId], references: [id], onDelete: Restrict)
  wageType         WageType
  rate             Float
  payableUnits     Float
  hoursWorked      Float?
  grossWage        Float
  status           WageEntryStatus @default(ACTIVE)
  approvedByUserId String
  approvedByUser   User            @relation("ApprovedWageEntries", fields: [approvedByUserId], references: [id], onDelete: Restrict)
  approvedAt       DateTime
  correctionId     String?
  correction       AttendanceCorrection? @relation(fields: [correctionId], references: [id], onDelete: SetNull)
  version          Int             @default(1)
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt

  @@index([organizationId, attendanceDate])
  @@index([workerId, attendanceDate])
  @@index([siteId, attendanceDate])
  @@index([attendanceId, status])
  @@map("wage_entries")
}

model AttendanceCorrection {
  id                   String           @id @default(uuid()) @map("_id")
  organizationId       String
  organization         Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  attendanceId         String
  attendance           Attendance       @relation(fields: [attendanceId], references: [id], onDelete: Cascade)
  previousStatus       AttendanceStatus
  previousHoursWorked  Float?
  previousPayableUnits Float
  previousWageAmount   Float
  newStatus            AttendanceStatus
  newHoursWorked       Float?
  newPayableUnits      Float
  newWageAmount        Float
  reason               String
  status               CorrectionStatus @default(PENDING)
  requestedByUserId    String
  requestedByUser      User             @relation("RequestedCorrections", fields: [requestedByUserId], references: [id], onDelete: Restrict)
  requestedAt          DateTime         @default(now())
  reviewedByUserId     String?
  reviewedByUser       User?            @relation("ReviewedCorrections", fields: [reviewedByUserId], references: [id], onDelete: SetNull)
  reviewedAt           DateTime?
  reviewNotes          String?
  createdAt            DateTime         @default(now())
  updatedAt            DateTime         @updatedAt

  wageEntries WageEntry[]

  @@index([organizationId, attendanceId])
  @@index([attendanceId, status])
  @@map("attendance_corrections")
}

model AuditLog {
  id             String       @id @default(uuid()) @map("_id")
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  userId         String?
  user           User?        @relation(fields: [userId], references: [id], onDelete: SetNull)
  action         String
  entityType     String
  entityId       String?
  metadata       Json?
  ipAddress      String?
  createdAt      DateTime     @default(now())

  @@index([organizationId, createdAt])
  @@index([entityType, entityId])
  @@map("audit_logs")
}

model EmailOutbox {
  id            String         @id @default(uuid()) @map("_id")
  recipient     String
  subject       String
  payload       Json
  attempts      Int            @default(0)
  maxAttempts   Int            @default(3)
  status        EmailJobStatus @default(PENDING)
  lastError     String?
  nextAttemptAt DateTime       @default(now())
  sentAt        DateTime?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  @@index([status, nextAttemptAt])
  @@map("email_outbox")
}

model RateLimitEntry {
  key      String   @id @map("_id")
  points   Int      @default(0)
  expireAt DateTime

  @@index([expireAt])
  @@map("rate_limit_entries")
}
