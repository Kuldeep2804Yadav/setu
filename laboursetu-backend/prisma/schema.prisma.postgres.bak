datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-3.0.x"]
}

enum Role {
  OWNER
  ACCOUNTANT
  SUPERVISOR
}

enum SiteStatus {
  ACTIVE
  ARCHIVED
}

enum WorkerStatus {
  ACTIVE
  INACTIVE
  ARCHIVED
}

enum VerificationStatus {
  UNVERIFIED
  AADHAAR_SUBMITTED
  VERIFIED
}

enum WageType {
  DAILY
  HOURLY
}

enum AssignmentStatus {
  ACTIVE
  COMPLETED
}

enum AttendanceStatus {
  PRESENT
  HALF_DAY
  ABSENT
}

enum SubmissionStatus {
  DRAFT
  SUBMITTED
  APPROVED
  REJECTED
}

enum CorrectionStatus {
  PENDING
  APPROVED
  REJECTED
}

enum WageEntryStatus {
  ACTIVE
  SUPERSEDED
  REVERSED
}

enum EmailJobStatus {
  PENDING
  PROCESSING
  SENT
  FAILED
}

model Organization {
  id        String   @id @default(uuid()) @db.Uuid
  name      String   @db.VarChar(120)
  slug      String   @unique @db.VarChar(120)
  code      String   @unique @db.VarChar(30)
  phone     String?  @db.VarChar(20)
  address   String?  @db.VarChar(300)
  gstin     String?  @db.VarChar(20)
  currency  String   @default("INR") @db.VarChar(10)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users                 User[]
  sessions              Session[]
  sites                 Site[]
  workers               Worker[]
  auditLogs             AuditLog[]
  attendanceSubmissions AttendanceSubmission[]
  attendances           Attendance[]
  wageEntries           WageEntry[]
  attendanceCorrections AttendanceCorrection[]

  @@map("organizations")
}

model User {
  id             String       @id @default(uuid()) @db.Uuid
  organizationId String       @db.Uuid
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  email          String       @unique @db.VarChar(150)
  phone          String?      @db.VarChar(20)
  passwordHash   String       @db.VarChar(255)
  name           String       @db.VarChar(120)
  role           Role         @default(SUPERVISOR)
  isActive       Boolean      @default(true)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  sessions             Session[]
  passwordResetTokens  PasswordResetToken[]
  supervisorSites      SupervisorSite[]
  createdWageRates     WageRate[]
  auditLogs            AuditLog[]
  submittedSubmissions AttendanceSubmission[] @relation("SubmittedSubmissions")
  approvedSubmissions  AttendanceSubmission[] @relation("ApprovedSubmissions")
  rejectedSubmissions  AttendanceSubmission[] @relation("RejectedSubmissions")
  approvedWageEntries  WageEntry[]            @relation("ApprovedWageEntries")
  requestedCorrections AttendanceCorrection[] @relation("RequestedCorrections")
  reviewedCorrections  AttendanceCorrection[] @relation("ReviewedCorrections")

  @@index([organizationId, role])
  @@map("users")
}

model Session {
  id             String       @id @default(uuid()) @db.Uuid
  token          String       @unique @db.VarChar(255)
  userId         String       @db.Uuid
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  organizationId String       @db.Uuid
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  ipAddress      String?      @db.VarChar(50)
  userAgent      String?      @db.VarChar(300)
  expiresAt      DateTime
  createdAt      DateTime     @default(now())

  @@index([token])
  @@index([userId])
  @@index([expiresAt])
  @@map("sessions")
}

model PasswordResetToken {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @db.Uuid
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique @db.VarChar(255)
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([tokenHash])
  @@map("password_reset_tokens")
}

model Site {
  id             String       @id @default(uuid()) @db.Uuid
  organizationId String       @db.Uuid
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  code           String       @db.VarChar(30)
  name           String       @db.VarChar(150)
  location       String?      @db.VarChar(300)
  clientName     String?      @db.VarChar(150)
  status         SiteStatus   @default(ACTIVE)
  archivedAt     DateTime?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  supervisorSites       SupervisorSite[]
  workerAssignments     WorkerSiteAssignment[]
  attendanceSubmissions AttendanceSubmission[]
  attendances           Attendance[]
  wageEntries           WageEntry[]

  @@unique([organizationId, code])
  @@index([organizationId, status])
  @@map("sites")
}

model SupervisorSite {
  id         String   @id @default(uuid()) @db.Uuid
  siteId     String   @db.Uuid
  site       Site     @relation(fields: [siteId], references: [id], onDelete: Cascade)
  userId     String   @db.Uuid
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  assignedAt DateTime @default(now())

  @@unique([siteId, userId])
  @@index([siteId])
  @@index([userId])
  @@map("supervisor_sites")
}

model Worker {
  id                 String             @id @default(uuid()) @db.Uuid
  organizationId     String             @db.Uuid
  organization       Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  code               String             @db.VarChar(30)
  name               String             @db.VarChar(120)
  normalizedName     String             @db.VarChar(120)
  mobileNumber       String?            @db.VarChar(20)
  trade              String             @db.VarChar(60)
  verificationStatus VerificationStatus @default(UNVERIFIED)
  aadhaarLastFour    String?            @db.VarChar(4)
  status             WorkerStatus       @default(ACTIVE)
  archivedAt         DateTime?
  notes              String?            @db.Text
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt

  siteAssignments WorkerSiteAssignment[]
  wageRates       WageRate[]
  attendances     Attendance[]
  wageEntries     WageEntry[]

  @@unique([organizationId, code])
  @@index([organizationId, status])
  @@index([organizationId, normalizedName, mobileNumber])
  @@index([organizationId, mobileNumber])
  @@map("workers")
}

model WorkerSiteAssignment {
  id        String           @id @default(uuid()) @db.Uuid
  workerId  String           @db.Uuid
  worker    Worker           @relation(fields: [workerId], references: [id], onDelete: Cascade)
  siteId    String           @db.Uuid
  site      Site             @relation(fields: [siteId], references: [id], onDelete: Cascade)
  startDate DateTime         @default(now())
  endDate   DateTime?
  status    AssignmentStatus @default(ACTIVE)
  notes     String?          @db.VarChar(300)
  createdAt DateTime         @default(now())

  @@index([workerId, status])
  @@index([siteId, status])
  @@map("worker_site_assignments")
}

model WageRate {
  id              String      @id @default(uuid()) @db.Uuid
  workerId        String      @db.Uuid
  worker          Worker      @relation(fields: [workerId], references: [id], onDelete: Cascade)
  wageType        WageType
  rate            Decimal     @db.Decimal(10, 2)
  effectiveFrom   DateTime
  effectiveTo     DateTime?
  notes           String?     @db.VarChar(300)
  createdByUserId String?     @db.Uuid
  createdByUser   User?       @relation(fields: [createdByUserId], references: [id], onDelete: SetNull)
  createdAt       DateTime    @default(now())
  wageEntries     WageEntry[]

  @@index([workerId, effectiveFrom])
  @@map("wage_rates")
}

model AttendanceSubmission {
  id                String           @id @default(uuid()) @db.Uuid
  organizationId    String           @db.Uuid
  organization      Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  siteId            String           @db.Uuid
  site              Site             @relation(fields: [siteId], references: [id], onDelete: Cascade)
  attendanceDate    DateTime         @db.Date
  status            SubmissionStatus @default(DRAFT)
  submittedByUserId String?          @db.Uuid
  submittedByUser   User?            @relation("SubmittedSubmissions", fields: [submittedByUserId], references: [id], onDelete: SetNull)
  submittedAt       DateTime?
  approvedByUserId  String?          @db.Uuid
  approvedByUser    User?            @relation("ApprovedSubmissions", fields: [approvedByUserId], references: [id], onDelete: SetNull)
  approvedAt        DateTime?
  rejectedByUserId  String?          @db.Uuid
  rejectedByUser    User?            @relation("RejectedSubmissions", fields: [rejectedByUserId], references: [id], onDelete: SetNull)
  rejectedAt        DateTime?
  rejectionReason   String?          @db.Text
  version           Int              @default(1)
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt

  attendances Attendance[]

  @@unique([organizationId, siteId, attendanceDate])
  @@index([organizationId, status])
  @@index([organizationId, attendanceDate])
  @@map("attendance_submissions")
}

model Attendance {
  id             String           @id @default(uuid()) @db.Uuid
  organizationId String           @db.Uuid
  organization   Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  submissionId   String           @db.Uuid
  submission     AttendanceSubmission @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  workerId       String           @db.Uuid
  worker         Worker           @relation(fields: [workerId], references: [id], onDelete: Cascade)
  siteId         String           @db.Uuid
  site           Site             @relation(fields: [siteId], references: [id], onDelete: Cascade)
  attendanceDate DateTime         @db.Date
  status         AttendanceStatus
  hoursWorked    Decimal?         @db.Decimal(5, 2)
  payableUnits   Decimal          @db.Decimal(5, 2)
  notes          String?          @db.VarChar(300)
  isCorrected    Boolean          @default(false)
  version        Int              @default(1)
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  wageEntries WageEntry[]
  corrections AttendanceCorrection[]

  @@unique([organizationId, workerId, attendanceDate])
  @@index([submissionId])
  @@index([organizationId, attendanceDate])
  @@index([siteId, attendanceDate])
  @@map("attendances")
}

model WageEntry {
  id               String          @id @default(uuid()) @db.Uuid
  organizationId   String          @db.Uuid
  organization     Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  attendanceId     String          @db.Uuid
  attendance       Attendance      @relation(fields: [attendanceId], references: [id], onDelete: Cascade)
  workerId         String          @db.Uuid
  worker           Worker          @relation(fields: [workerId], references: [id], onDelete: Cascade)
  siteId           String          @db.Uuid
  site             Site            @relation(fields: [siteId], references: [id], onDelete: Cascade)
  attendanceDate   DateTime        @db.Date
  wageRateId       String          @db.Uuid
  wageRate         WageRate        @relation(fields: [wageRateId], references: [id], onDelete: Restrict)
  wageType         WageType
  rate             Decimal         @db.Decimal(10, 2)
  payableUnits     Decimal         @db.Decimal(5, 2)
  hoursWorked      Decimal?        @db.Decimal(5, 2)
  grossWage        Decimal         @db.Decimal(10, 2)
  status           WageEntryStatus @default(ACTIVE)
  approvedByUserId String          @db.Uuid
  approvedByUser   User            @relation("ApprovedWageEntries", fields: [approvedByUserId], references: [id], onDelete: Restrict)
  approvedAt       DateTime
  correctionId     String?         @db.Uuid
  correction       AttendanceCorrection? @relation(fields: [correctionId], references: [id], onDelete: SetNull)
  version          Int             @default(1)
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt

  @@index([organizationId, attendanceDate])
  @@index([workerId, attendanceDate])
  @@index([siteId, attendanceDate])
  @@index([attendanceId, status])
  @@map("wage_entries")
}

model AttendanceCorrection {
  id                   String           @id @default(uuid()) @db.Uuid
  organizationId       String           @db.Uuid
  organization         Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  attendanceId         String           @db.Uuid
  attendance           Attendance       @relation(fields: [attendanceId], references: [id], onDelete: Cascade)
  previousStatus       AttendanceStatus
  previousHoursWorked  Decimal?         @db.Decimal(5, 2)
  previousPayableUnits Decimal          @db.Decimal(5, 2)
  previousWageAmount   Decimal          @db.Decimal(10, 2)
  newStatus            AttendanceStatus
  newHoursWorked       Decimal?         @db.Decimal(5, 2)
  newPayableUnits      Decimal          @db.Decimal(5, 2)
  newWageAmount        Decimal          @db.Decimal(10, 2)
  reason               String           @db.Text
  status               CorrectionStatus @default(PENDING)
  requestedByUserId    String           @db.Uuid
  requestedByUser      User             @relation("RequestedCorrections", fields: [requestedByUserId], references: [id], onDelete: Restrict)
  requestedAt          DateTime         @default(now())
  reviewedByUserId     String?          @db.Uuid
  reviewedByUser       User?            @relation("ReviewedCorrections", fields: [reviewedByUserId], references: [id], onDelete: SetNull)
  reviewedAt           DateTime?
  reviewNotes          String?          @db.Text
  createdAt            DateTime         @default(now())
  updatedAt            DateTime         @updatedAt

  wageEntries WageEntry[]

  @@index([organizationId, attendanceId])
  @@index([attendanceId, status])
  @@map("attendance_corrections")
}

model AuditLog {
  id             String       @id @default(uuid()) @db.Uuid
  organizationId String       @db.Uuid
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  userId         String?      @db.Uuid
  user           User?        @relation(fields: [userId], references: [id], onDelete: SetNull)
  action         String       @db.VarChar(100)
  entityType     String       @db.VarChar(60)
  entityId       String?      @db.VarChar(60)
  metadata       Json?
  ipAddress      String?      @db.VarChar(50)
  createdAt      DateTime     @default(now())

  @@index([organizationId, createdAt])
  @@index([entityType, entityId])
  @@map("audit_logs")
}

model EmailOutbox {
  id            String         @id @default(uuid()) @db.Uuid
  recipient     String         @db.VarChar(150)
  subject       String         @db.VarChar(200)
  payload       Json
  attempts      Int            @default(0)
  maxAttempts   Int            @default(3)
  status        EmailJobStatus @default(PENDING)
  lastError     String?        @db.Text
  nextAttemptAt DateTime       @default(now())
  sentAt        DateTime?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  @@index([status, nextAttemptAt])
  @@map("email_outbox")
}

model RateLimitEntry {
  key      String   @id @db.VarChar(150)
  points   Int      @default(0)
  expireAt DateTime

  @@index([expireAt])
  @@map("rate_limit_entries")
}
