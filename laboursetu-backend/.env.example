PORT=5000
NODE_ENV=development
DATABASE_URL=mongodb://127.0.0.1:27017/laboursetu?replicaSet=rs0
FRONTEND_URL=http://localhost:3000
# Optional comma-separated allowlist; overrides FRONTEND_URL (legacy: CORS_ORIGIN).
# CORS_ORIGINS=https://app.example.com
SESSION_SECRET=replace-with-a-random-secret-of-at-least-32-characters
COOKIE_SAME_SITE=lax
# Host-only cookies are recommended. Only set if sharing across trusted subdomains.
# COOKIE_DOMAIN=.example.com
# TEST_DATABASE_URL=postgresql://USER:PASSWORD@localhost:5432/laboursetu_test?schema=public
# ALLOW_TEST_DATABASE_CLEANUP=true
# ALLOW_DESTRUCTIVE_SEED=true
# Review docs/PHASE_3_MONGODB.md before setting this for the additive index migration.
# PHASE3_APPLY_ADDITIVE=true
# Finance tests provision their own disposable MongoDB replica set.
