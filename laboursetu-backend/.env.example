PORT=5000
NODE_ENV=development
DATABASE_URL=postgresql://postgres:root@localhost:5432/labourse
FRONTEND_URL=http://localhost:3000
# Optional comma-separated allowlist; overrides FRONTEND_URL (legacy: CORS_ORIGIN).
# CORS_ORIGINS=https://app.example.com
SESSION_SECRET=laboursetu
COOKIE_SAME_SITE=lax
# Host-only cookies are recommended. Only set if sharing across trusted subdomains.
# COOKIE_DOMAIN=.example.com
# TEST_DATABASE_URL=postgresql://USER:PASSWORD@localhost:5432/laboursetu_test?schema=public
# ALLOW_TEST_DATABASE_CLEANUP=true
# ALLOW_DESTRUCTIVE_SEED=true
